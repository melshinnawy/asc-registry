{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/melshinnawy/asc-registry/schema/test.schema.json",
  "title": "ASC Security Test",
  "description": "ASC Registry security validation test definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "control", "title", "objective", "test_steps",
    "expected_results", "pass_criteria", "severity"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^TEST-[0-9]{3}$" },
    "control": { "type": "string", "pattern": "^ASC-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 5 },
    "objective": { "type": "string", "minLength": 10 },
    "preconditions": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "test_steps": {
      "type": "array", "minItems": 2,
      "items": { "type": "string", "minLength": 3 }
    },
    "expected_results": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "pass_criteria": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] }
  }
}
