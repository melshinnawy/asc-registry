{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/melshinnawy/asc-registry/schema/control.schema.json",
  "title": "AI Security Control",
  "description": "ASC Registry control definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "status", "created", "updated", "risk", "description",
    "implementation", "validation", "monitoring", "framework_mappings",
    "references", "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ASC-[0-9]{3}$",
      "description": "Permanent, never-reused ASC control identifier"
    },
    "title": { "type": "string", "minLength": 5 },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated"] },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "risk": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "description": { "type": "string", "minLength": 20 },
    "implementation": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "validation": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "monitoring": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "framework_mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mitre_atlas", "owasp_llm", "nist_ai_rmf"],
      "properties": {
        "mitre_atlas": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$" }
        },
        "owasp_llm": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^LLM(0[1-9]|10)$" }
        },
        "nist_ai_rmf": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(GOVERN|MAP|MEASURE|MANAGE)\\.[0-9]+$" }
        }
      }
    },
    "references": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
