{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Security Control",
  "description": "ASC Registry Control Definition",
  "type": "object",

  "required": [
    "id",
    "title",
    "status",
    "risk",
    "description",
    "implementation",
    "validation",
    "monitoring",
    "version"
  ],

  "properties": {

    "id": {
      "type": "string",
      "pattern": "^ASC-[0-9]{3}$",
      "description": "Unique ASC Control Identifier"
    },

    "title": {
      "type": "string",
      "minLength": 5
    },

    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },

    "risk": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "description": {
      "type": "string",
      "minLength": 20
    },

    "implementation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    }
  },

  "additionalProperties": false
}
`
