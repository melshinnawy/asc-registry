{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Security Control",
  "description": "ASC Registry Control Definition",
  "type": "object",

  "required": [
    "id",
    "title",
    "status",
    "created",
    "updated",
    "risk",
    "description",
    "implementation",
    "validation",
    "monitoring",
    "framework_mappings",
    "references",
    "version"
  ],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ASC-[0-9]{3}$",
      "description": "Unique ASC Control Identifier"
    },

    "title": {
      "type": "string",
      "minLength": 5
    },

    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },

    "created": {
      "type": "string",
      "format": "date"
    },

    "updated": {
      "type": "string",
      "format": "date"
    },

    "risk": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "description": {
      "type": "string",
      "minLength": 20
    },

    "implementation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

